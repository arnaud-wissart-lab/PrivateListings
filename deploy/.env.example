# Copiez ce fichier vers deploy/.env sur le GEEKOM, puis remplacez toutes les valeurs sensibles.
# Ne commitez jamais deploy/.env.

# Images GHCR publiées par .github/workflows/deploy.yml.
PRIVATE_LISTINGS_WEB_IMAGE=ghcr.io/<owner>/private-listings-web
PRIVATE_LISTINGS_WORKER_IMAGE=ghcr.io/<owner>/private-listings-worker
PRIVATE_LISTINGS_IMAGE_TAG=latest

# Publication HTTP locale. Garder 127.0.0.1 si un reverse proxy tourne sur le même hôte.
PRIVATE_LISTINGS_WEB_BIND=127.0.0.1
PRIVATE_LISTINGS_WEB_HTTP_PORT=8080
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_FORWARDEDHEADERS_ENABLED=true

# PostgreSQL.
POSTGRES_IMAGE=postgres:18-alpine
POSTGRES_DB=privatelistings
POSTGRES_USER=privatelistings
POSTGRES_PASSWORD=change-me-with-a-long-random-password

# Volumes Docker nommés.
PRIVATE_LISTINGS_POSTGRES_VOLUME=privatelistings_postgres_data
PRIVATE_LISTINGS_UPLOADS_VOLUME=privatelistings_uploads
PRIVATE_LISTINGS_NETWORK=privatelistings

# Initialisation applicative.
# Production recommandée : false par défaut, migration lancée manuellement ou après sauvegarde validée.
PRIVATE_LISTINGS_APPLY_MIGRATIONS_ON_STARTUP=false
PRIVATE_LISTINGS_SEED_INITIAL_CATEGORIES=false
PRIVATE_LISTINGS_DEMO_SEED_ENABLED=false
PRIVATE_LISTINGS_DEMO_SEED_ALLOW_IN_PRODUCTION=false
PRIVATE_LISTINGS_EXPOSE_HEALTH_ENDPOINTS=true

# Worker.
PRIVATE_LISTINGS_WORKER_LISTING_EXPIRATION_INTERVAL=00:15:00

# SMTP production. Laissez vide si les emails ne sont pas encore configurés.
PRIVATE_LISTINGS_EMAIL_FROM_ADDRESS=noreply@privatelistings.local
PRIVATE_LISTINGS_EMAIL_FROM_NAME=PrivateListings
PRIVATE_LISTINGS_SMTP_HOST=
PRIVATE_LISTINGS_SMTP_PORT=587
PRIVATE_LISTINGS_SMTP_USERNAME=
PRIVATE_LISTINGS_SMTP_PASSWORD=
PRIVATE_LISTINGS_SMTP_ENABLE_SSL=true

# MailPit hors production uniquement :
# docker compose --env-file deploy/.env -f deploy/docker-compose.geekom.yml --profile nonproduction up -d
MAILPIT_IMAGE=axllent/mailpit:latest
MAILPIT_SMTP_BIND=127.0.0.1
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_BIND=127.0.0.1
MAILPIT_UI_PORT=8025

# Watchtower, seulement si le service Watchtower du GEEKOM est configuré avec --label-enable.
WATCHTOWER_ENABLE=false

# Logs Docker json-file.
DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILE=5

# Export OpenTelemetry optionnel.
OTEL_EXPORTER_OTLP_ENDPOINT=

# Scripts de sauvegarde.
PRIVATE_LISTINGS_BACKUP_DIRECTORY=./backups
PRIVATE_LISTINGS_BACKUP_RETENTION_DAYS=14
