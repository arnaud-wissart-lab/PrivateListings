{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "PrivateListings": {
    "Persistence": {
      "ConnectionName": "privatelistingsdb",
      "ApplyMigrationsOnStartup": false
    },
    "ReferenceData": {
      "SeedInitialCategories": false
    },
    "DemoSeed": {
      "Enabled": false,
      "AllowInProduction": false
    },
    "ListingImages": {
      "MaxSizeInBytes": 5242880,
      "MaxImagesPerListing": 8
    },
    "ListingRateLimits": {
      "CreatePermitLimit": 10,
      "UploadPermitLimit": 30,
      "Window": "00:10:00",
      "BlockDuration": "00:10:00"
    },
    "Worker": {
      "ListingExpiration": {
        "Interval": "00:15:00"
      }
    }
  }
}
