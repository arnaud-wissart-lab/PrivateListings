{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "PrivateListings": {
    "PublicBaseUrl": "https://localhost:7110",
    "DataProtection": {
      "KeysPath": ""
    },
    "Persistence": {
      "ConnectionName": "privatelistingsdb",
      "ApplyMigrationsOnStartup": false
    },
    "ReferenceData": {
      "SeedInitialCategories": false
    },
    "DemoSeed": {
      "Enabled": false
    },
    "ListingImages": {
      "MaxSizeInBytes": 5242880,
      "MaxImagesPerListing": 8
    },
    "ListingRateLimits": {
      "CreatePermitLimit": 10,
      "UploadPermitLimit": 30,
      "Window": "00:10:00",
      "BlockDuration": "00:10:00"
    },
    "Email": {
      "FromAddress": "noreply@privatelistings.local",
      "FromName": "PrivateListings"
    }
  },
  "AllowedHosts": "*"
}
