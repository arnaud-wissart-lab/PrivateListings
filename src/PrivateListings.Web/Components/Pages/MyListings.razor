@page "/mes-annonces"
@attribute [Authorize]

@using Microsoft.AspNetCore.Identity
@using PrivateListings.Infrastructure.Identity

@inject IListingService ListingService
@inject UserManager<PrivateListingsUser> UserManager

<PageTitle>Mes annonces</PageTitle>

<section class="listing-page">
    <div class="listing-toolbar">
        <div>
            <h1>Mes annonces</h1>
            <p class="listing-muted">Brouillons, annonces publiées et annonces expirées.</p>
        </div>
        <a class="primary-link-button" href="/annonces/nouvelle">Nouvelle annonce</a>
    </div>

    @if (listings.Count == 0)
    {
        <div class="listing-empty">
            <h2>Aucune annonce</h2>
            <p>Créez un premier brouillon pour préparer votre publication.</p>
            <a class="primary-link-button" href="/annonces/nouvelle">Créer une annonce</a>
        </div>
    }
    else
    {
        <div class="listing-owner-table">
            @foreach (var listing in listings)
            {
                <article class="listing-owner-row">
                    <div>
                        <span class="status-pill @ListingDisplay.StatusClass(listing.Status)">@ListingDisplay.StatusLabel(listing.Status)</span>
                        <h2><a href="@($"/annonces/{listing.Id.Value:D}")">@listing.Title</a></h2>
                        <p>@listing.CategoryName · @ListingDisplay.TypeLabel(listing.Type) · @(listing.ApproximateLocation ?? "Secteur non précisé")</p>
                    </div>
                    <div class="listing-actions">
                        <a class="secondary-link-button" href="@($"/annonces/{listing.Id.Value:D}/modifier")">Modifier</a>
                        @if (listing.Status is ListingStatus.Draft or ListingStatus.Expired)
                        {
                            <form method="post" action="@($"/annonces/{listing.Id.Value:D}/publier")">
                                <AntiforgeryToken />
                                <button type="submit" class="primary-button">Publier</button>
                            </form>
                        }
                    </div>
                </article>
            }
        </div>
    }
</section>

@code {
    private IReadOnlyList<ListingSummary> listings = [];

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        var user = await UserManager.GetUserAsync(HttpContext.User);
        listings = user is null
            ? []
            : await ListingService.ListOwnerListingsAsync(user.UserProfileId);
    }
}
