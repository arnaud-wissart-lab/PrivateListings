@page "/"

<PageTitle>Accueil</PageTitle>

<section class="home-page dashboard-page">
    <PageHeader Title="Tableau de bord"
                Subtitle="Annonces privées, coups de main, événements et projets d'entraide locale."
                Eyebrow="PrivateListings">
        <Actions>
            <AuthorizeView>
                <Authorized>
                    <a class="primary-link-button" href="/annonces">Voir les annonces</a>
                </Authorized>
                <NotAuthorized>
                    <a class="primary-link-button" href="/login">Se connecter</a>
                </NotAuthorized>
            </AuthorizeView>
            <a class="secondary-link-button" href="/donnees-securite">Données &amp; sécurité</a>
            <AuthorizeView>
                <Authorized>
                    <a class="secondary-link-button" href="/annonces/nouvelle">Créer une annonce</a>
                </Authorized>
                <NotAuthorized>
                    <a class="secondary-link-button" href="/register">Créer un compte</a>
                </NotAuthorized>
            </AuthorizeView>
        </Actions>
    </PageHeader>

    <AuthorizeView>
        <Authorized>
            <div class="dashboard-grid">
                <a class="dashboard-tile" href="/annonces">
                    <span class="nav-icon nav-icon-listings" aria-hidden="true"></span>
                    <strong>Annonces</strong>
                    <span>Parcourir les offres, recherches et services du voisinage.</span>
                </a>
                <a class="dashboard-tile" href="/annonces/nouvelle">
                    <span class="nav-icon nav-icon-publish" aria-hidden="true"></span>
                    <strong>Publier</strong>
                    <span>Préparer un brouillon et ajouter les images utiles.</span>
                </a>
                <a class="dashboard-tile" href="/messagerie">
                    <span class="nav-icon nav-icon-messages" aria-hidden="true"></span>
                    <strong>Messages</strong>
                    <span>Retrouver les échanges liés à vos annonces.</span>
                </a>
                <a class="dashboard-tile" href="/profil">
                    <span class="nav-icon nav-icon-profile" aria-hidden="true"></span>
                    <strong>Profil</strong>
                    <span>Consulter votre espace membre et la sécurité du compte.</span>
                </a>
            </div>
        </Authorized>
        <NotAuthorized>
            <div class="dashboard-grid">
                <article class="dashboard-tile">
                    <span class="nav-icon nav-icon-listings" aria-hidden="true"></span>
                    <strong>Annonces locales</strong>
                    <span>Objets, services, événements et entraide regroupés dans une interface sobre.</span>
                </article>
                <article class="dashboard-tile">
                    <span class="nav-icon nav-icon-profile" aria-hidden="true"></span>
                    <strong>Compte privé</strong>
                    <span>Connexion requise pour publier, répondre et accéder à la messagerie.</span>
                </article>
            </div>
        </NotAuthorized>
    </AuthorizeView>
</section>
