@page "/"

<PageTitle>Accueil</PageTitle>

<section class="home-page">
    <div class="home-intro">
        <h1>PrivateListings</h1>
        <p>Annonces privées, coups de main, événements et projets d'entraide locale.</p>
        <div class="home-actions">
            <a class="primary-link-button" href="/annonces">Voir les annonces</a>
            <AuthorizeView>
                <Authorized>
                    <a class="secondary-link-button" href="/annonces/nouvelle">Créer une annonce</a>
                </Authorized>
                <NotAuthorized>
                    <a class="secondary-link-button" href="/register">Créer un compte</a>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </div>
</section>
