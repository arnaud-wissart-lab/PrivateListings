@page "/donnees-securite"

<PageTitle>Données &amp; sécurité</PageTitle>

<section class="home-page dashboard-page">
    <PageHeader Title="@("Données & sécurité")"
                Subtitle="Les principes appliqués aux comptes, aux annonces, à la messagerie et au mode démo."
                Eyebrow="Confiance" />

    <div class="dashboard-grid">
        <article class="dashboard-tile">
            <span class="nav-icon nav-icon-profile" aria-hidden="true"></span>
            <strong>Données minimisées</strong>
            <span>PrivateListings collecte uniquement les informations nécessaires au service et à la modération.</span>
        </article>

        <article class="dashboard-tile">
            <span class="nav-icon nav-icon-admin" aria-hidden="true"></span>
            <strong>Sécurité des accès</strong>
            <span>Les actions sensibles sont protégées, journalisées et réservées aux rôles autorisés.</span>
        </article>

        <article class="dashboard-tile">
            <span class="nav-icon nav-icon-messages" aria-hidden="true"></span>
            <strong>Messages privés</strong>
            <span>Les notifications signalent l'activité sans inclure le contenu des conversations.</span>
        </article>

        <article class="dashboard-tile">
            <span class="nav-icon nav-icon-listings" aria-hidden="true"></span>
            <strong>Données fictives en mode démo</strong>
            <span>Les comptes et annonces de démonstration sont prévisibles, isolés et sans donnée réelle.</span>
        </article>
    </div>
</section>
