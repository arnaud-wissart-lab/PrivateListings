@page "/annonces/nouvelle"
@attribute [Authorize]

@using Microsoft.AspNetCore.Identity
@using PrivateListings.Infrastructure.Identity
@using PrivateListings.Web.Components.Account

@inject IListingService ListingService
@inject UserManager<PrivateListingsUser> UserManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>Nouvelle annonce</PageTitle>

<section class="listing-page listing-form-page">
    <div class="listing-form-shell">
        <PageHeader Title="Nouvelle annonce" Subtitle="Préparez un brouillon avant de publier.">
            <Actions>
                <a href="/annonces" class="secondary-link-button">Annonces</a>
            </Actions>
        </PageHeader>

        <StatusMessage Message="@statusMessage" />

        <ListingForm Input="Input"
                     Categories="categories"
                     FormName="create-listing"
                     IdPrefix="create-listing"
                     SubmitLabel="Créer le brouillon"
                     OnValidSubmit="CreateAsync" />
    </div>
</section>

@code {
    private IReadOnlyList<ListingCategoryOption> categories = [];
    private string? statusMessage;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private ListingFormInput Input { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();
        categories = await ListingService.ListCategoriesAsync();
    }

    private async Task CreateAsync()
    {
        var user = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            statusMessage = "Erreur : session invalide.";
            return;
        }

        if (!Input.TryBuildCategoryId(out var categoryId))
        {
            statusMessage = "Erreur : la catégorie sélectionnée est invalide.";
            return;
        }

        var result = await ListingService.CreateAsync(new CreateListingCommand(
            user.UserProfileId,
            categoryId,
            Input.Title,
            Input.Description,
            Input.Type,
            Input.ApproximateLocation,
            Input.Price,
            Input.BuildEventDate(),
            Input.BuildExpirationDate(),
            BuildRequestContext()));

        if (result.Succeeded && result.ListingId.HasValue)
        {
            RedirectManager.RedirectToWithStatus(
                $"/annonces/{result.ListingId.Value.Value:D}/modifier",
                "Annonce créée en brouillon.",
                HttpContext);
            return;
        }

        statusMessage = FormatResult(result);
    }

    private ListingRequestContext BuildRequestContext()
        => new(
            HttpContext.Connection.RemoteIpAddress?.ToString(),
            HttpContext.Request.Headers["User-Agent"].ToString());

    private static string FormatResult(ListingOperationResult result)
        => result.Status == ListingOperationStatus.RateLimited
            ? "Erreur : trop de tentatives. Réessayez plus tard."
            : $"Erreur : {string.Join(" ", result.Errors ?? ["la création n'a pas pu aboutir."])}";
}
