@page "/admin/signalements"
@attribute [Authorize(Policy = BackOfficePolicies.Moderation)]

@using Microsoft.AspNetCore.WebUtilities

@inject IBackOfficeService BackOfficeService

<PageTitle>Signalements - Back-office</PageTitle>

<AdminShell Title="Signalements" Subtitle="Traitement des signalements sans exposition globale des conversations privées." Active="reports">
    <ChildContent>
        <form method="get" class="admin-filter-bar">
            <label class="field-label" for="q">Recherche</label>
            <input id="q" name="q" value="@Q" class="field-input" placeholder="Motif, détail ou rapporteur" />

            <label class="field-label" for="status">Statut</label>
            <select id="status" name="status" class="field-input">
                <option value="">Tous</option>
                @foreach (var status in Enum.GetValues<ReportStatus>())
                {
                    <option value="@status" selected="@(Status == status.ToString())">@BackOfficeDisplay.ReportStatusLabel(status)</option>
                }
            </select>

            <button type="submit" class="primary-button">Filtrer</button>
            <a class="secondary-link-button" href="/admin/signalements">Réinitialiser</a>
        </form>

        @if (reports.Items.Count == 0)
        {
            <EmptyState Title="Aucun signalement"
                        Description="Aucun signalement ne correspond aux critères actuels." />
        }
        else
        {
            <AdminTable>
                <HeaderContent>
                    <tr>
                        <th>Signalement</th>
                        <th>Cible</th>
                        <th>Statut</th>
                        <th>Rapporteur</th>
                        <th>Revue</th>
                        <th class="admin-actions-cell">Traitement</th>
                    </tr>
                </HeaderContent>
                <ChildContent>
                    @foreach (var report in reports.Items)
                    {
                        <tr>
                            <td>
                                <strong>@report.Reason</strong>
                                @if (!string.IsNullOrWhiteSpace(report.Details))
                                {
                                    <small>@report.Details</small>
                                }
                                <small>@BackOfficeDisplay.FormatDate(report.CreatedAt)</small>
                            </td>
                            <td>
                                <span>@BackOfficeDisplay.TargetTypeLabel(report.TargetType)</span>
                                <small>@(report.TargetLabel ?? report.TargetId.ToString("D"))</small>
                            </td>
                            <td>
                                <StatusBadge CssClass="@BackOfficeDisplay.ReportStatusClass(report.Status)"
                                             Text="@BackOfficeDisplay.ReportStatusLabel(report.Status)" />
                            </td>
                            <td>@report.ReporterDisplayName</td>
                            <td>
                                <small>@BackOfficeDisplay.FormatDate(report.ReviewedAt)</small>
                                @if (!string.IsNullOrWhiteSpace(report.ReviewedByDisplayName))
                                {
                                    <small>@report.ReviewedByDisplayName</small>
                                }
                                @if (!string.IsNullOrWhiteSpace(report.ResolutionNote))
                                {
                                    <small>@report.ResolutionNote</small>
                                }
                            </td>
                            <td class="admin-actions-cell">
                                @if (report.Status is ReportStatus.Resolved or ReportStatus.Rejected)
                                {
                                    <span class="admin-muted">Clôturé</span>
                                }
                                else if (report.TargetType == ReportTargetType.Listing)
                                {
                                    @ReportActions(report)
                                }
                                else
                                {
                                    <AuthorizeView Policy="@BackOfficePolicies.Admin">
                                        <Authorized>
                                            @ReportActions(report)
                                        </Authorized>
                                        <NotAuthorized>
                                            <span class="admin-muted">Réservé Admin</span>
                                        </NotAuthorized>
                                    </AuthorizeView>
                                }
                            </td>
                        </tr>
                    }
                </ChildContent>
            </AdminTable>
        }

        <AdminPagination CurrentPage="@reports.Page" TotalPages="@reports.TotalPages" BuildUrl="BuildPageUrl" />
    </ChildContent>
</AdminShell>

@code {
    private BackOfficePagedResult<BackOfficeReportSummary> reports = new([], 1, 20, 0);

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromQuery(Name = "q")]
    private string? Q { get; set; }

    [SupplyParameterFromQuery(Name = "status")]
    private string? Status { get; set; }

    [SupplyParameterFromQuery(Name = "page")]
    private int Page { get; set; } = 1;

    private string ReturnUrl => $"{HttpContext.Request.Path}{HttpContext.Request.QueryString}";

    protected override async Task OnParametersSetAsync()
    {
        reports = await BackOfficeService.ListReportsAsync(new BackOfficeReportQuery(
            Q,
            ParseStatus(Status),
            Page));
    }

    private RenderFragment ReportActions(BackOfficeReportSummary report) => @<div class="admin-action-stack">
        @if (report.Status == ReportStatus.Open)
        {
            <form method="post" action="@($"/admin/actions/reports/{report.Id.Value:D}/review")" class="admin-row-form">
                <AntiforgeryToken />
                <input type="hidden" name="returnUrl" value="@ReturnUrl" />
                <input type="hidden" name="note" value="Prise en revue depuis le back-office." />
                <label class="confirm-line">
                    <input type="checkbox" name="confirm" value="true" required />
                    <span>Confirmer</span>
                </label>
                <button type="submit" class="secondary-button">Prendre en revue</button>
            </form>
        }
        <form method="post" action="@($"/admin/actions/reports/{report.Id.Value:D}/resolve")" class="admin-row-form">
            <AntiforgeryToken />
            <input type="hidden" name="returnUrl" value="@ReturnUrl" />
            <textarea name="note" class="field-input textarea-input" maxlength="1000" placeholder="Note de résolution" required></textarea>
            <label class="confirm-line">
                <input type="checkbox" name="confirm" value="true" required />
                <span>Confirmer</span>
            </label>
            <button type="submit" class="primary-button">Résoudre</button>
        </form>
        <form method="post" action="@($"/admin/actions/reports/{report.Id.Value:D}/reject")" class="admin-row-form">
            <AntiforgeryToken />
            <input type="hidden" name="returnUrl" value="@ReturnUrl" />
            <textarea name="note" class="field-input textarea-input" maxlength="1000" placeholder="Motif de rejet" required></textarea>
            <label class="confirm-line">
                <input type="checkbox" name="confirm" value="true" required />
                <span>Confirmer</span>
            </label>
            <button type="submit" class="secondary-button">Rejeter</button>
        </form>
    </div>;

    private string BuildPageUrl(int page)
        => QueryHelpers.AddQueryString(
            "/admin/signalements",
            new Dictionary<string, string?>
            {
                ["q"] = Q,
                ["status"] = Status,
                ["page"] = page.ToString()
            });

    private static ReportStatus? ParseStatus(string? value)
        => Enum.TryParse<ReportStatus>(value, ignoreCase: false, out var status) ? status : null;
}
