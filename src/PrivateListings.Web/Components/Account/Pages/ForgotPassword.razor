@page "/forgot-password"
@page "/Account/ForgotPassword"

@using System.ComponentModel.DataAnnotations
@using PrivateListings.Web.Components.Account
@using PrivateListings.Web.PublicUrls

@inject IUserAccountService AccountService
@inject IdentityRedirectManager RedirectManager
@inject IPublicUrlBuilder PublicUrlBuilder

<PageTitle>Mot de passe oublié</PageTitle>

<section class="account-page">
    <div class="account-panel">
        <h1>Mot de passe oublié</h1>
        <p class="account-muted">Si un compte correspond à cet email, un lien temporaire sera envoyé.</p>

        <StatusMessage Message="@statusMessage" />

        <EditForm Model="Input" method="post" FormName="forgot-password" OnValidSubmit="RequestResetAsync" class="account-form">
            <DataAnnotationsValidator />
            <ValidationSummary class="account-validation" role="alert" />

            <label class="field-label" for="forgot-email">Email</label>
            <InputText id="forgot-email" @bind-Value="Input.Email" class="field-input" autocomplete="username" />
            <ValidationMessage For="() => Input.Email" class="field-validation" />

            <button type="submit" class="primary-button">Envoyer le lien</button>
        </EditForm>

        <div class="account-links">
            <a href="/login">Retour à la connexion</a>
        </div>
    </div>
</section>

@code {
    private string? statusMessage;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    protected override void OnInitialized()
    {
        Input ??= new();
    }

    private async Task RequestResetAsync()
    {
        var result = await AccountService.RequestPasswordResetAsync(new RequestPasswordResetCommand(
            Input.Email,
            PublicUrlBuilder.BuildAbsoluteUrl("/reset-password"),
            BuildRequestContext()));

        if (result.Status == AccountOperationStatus.RateLimited)
        {
            statusMessage = "Erreur : trop de tentatives. Réessayez plus tard.";
            return;
        }

        RedirectManager.RedirectToWithStatus(
            "/login",
            "Si un compte correspond à cet email, un lien de réinitialisation a été envoyé.",
            HttpContext);
    }

    private AccountRequestContext BuildRequestContext()
        => new(
            HttpContext.Connection.RemoteIpAddress?.ToString(),
            HttpContext.Request.Headers["User-Agent"].ToString());

    private sealed class InputModel
    {
        [Required(ErrorMessage = "L'email est obligatoire.")]
        [EmailAddress(ErrorMessage = "L'email est invalide.")]
        public string Email { get; set; } = string.Empty;
    }
}
