@page "/reset-password"
@page "/Account/ResetPassword"

@using System.ComponentModel.DataAnnotations
@using PrivateListings.Web.Components.Account

@inject IUserAccountService AccountService
@inject IdentityRedirectManager RedirectManager

<PageTitle>Réinitialisation</PageTitle>

<section class="account-page">
    <div class="account-panel">
        <h1>Réinitialisation</h1>
        <p class="account-muted">Définissez un nouveau mot de passe pour votre compte.</p>

        <StatusMessage Message="@statusMessage" />

        <EditForm Model="Input" method="post" FormName="reset-password" OnValidSubmit="ResetAsync" class="account-form">
            <DataAnnotationsValidator />
            <ValidationSummary class="account-validation" role="alert" />

            <input type="hidden" name="Input.UserId" value="@Input.UserId" />
            <input type="hidden" name="Input.Code" value="@Input.Code" />

            <label class="field-label" for="reset-password">Nouveau mot de passe</label>
            <InputText id="reset-password" type="password" @bind-Value="Input.Password" class="field-input" autocomplete="new-password" />
            <ValidationMessage For="() => Input.Password" class="field-validation" />

            <label class="field-label" for="reset-confirm-password">Confirmation</label>
            <InputText id="reset-confirm-password" type="password" @bind-Value="Input.ConfirmPassword" class="field-input" autocomplete="new-password" />
            <ValidationMessage For="() => Input.ConfirmPassword" class="field-validation" />

            <button type="submit" class="primary-button">Réinitialiser</button>
        </EditForm>
    </div>
</section>

@code {
    private string? statusMessage;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    [SupplyParameterFromQuery]
    private Guid? UserId { get; set; }

    [SupplyParameterFromQuery(Name = "code")]
    private string? Code { get; set; }

    protected override void OnInitialized()
    {
        Input ??= new();

        if (HttpMethods.IsGet(HttpContext.Request.Method))
        {
            Input.UserId = UserId?.ToString("D") ?? string.Empty;
            Input.Code = Code ?? string.Empty;
        }

        if (string.IsNullOrWhiteSpace(Input.UserId) || string.IsNullOrWhiteSpace(Input.Code))
        {
            statusMessage = "Erreur : lien de réinitialisation invalide.";
        }
    }

    private async Task ResetAsync()
    {
        if (!Guid.TryParse(Input.UserId, out var userId))
        {
            statusMessage = "Erreur : lien de réinitialisation invalide.";
            return;
        }

        var result = await AccountService.ResetPasswordAsync(new ResetPasswordCommand(
            userId,
            Input.Code,
            Input.Password,
            BuildRequestContext()));

        if (result.Succeeded)
        {
            RedirectManager.RedirectToWithStatus(
                "/login",
                "Mot de passe réinitialisé. Vous pouvez vous connecter.",
                HttpContext);
            return;
        }

        statusMessage = result.Status == AccountOperationStatus.RateLimited
            ? "Erreur : trop de tentatives. Réessayez plus tard."
            : $"Erreur : {string.Join(" ", result.Errors ?? ["la réinitialisation n'a pas pu aboutir."])}";
    }

    private AccountRequestContext BuildRequestContext()
        => new(
            HttpContext.Connection.RemoteIpAddress?.ToString(),
            HttpContext.Request.Headers["User-Agent"].ToString());

    private sealed class InputModel
    {
        public string UserId { get; set; } = string.Empty;

        public string Code { get; set; } = string.Empty;

        [Required(ErrorMessage = "Le mot de passe est obligatoire.")]
        [StringLength(256, MinimumLength = 12, ErrorMessage = "Le mot de passe doit contenir entre 12 et 256 caractères.")]
        [DataType(DataType.Password)]
        public string Password { get; set; } = string.Empty;

        [DataType(DataType.Password)]
        [Compare(nameof(Password), ErrorMessage = "Les mots de passe ne correspondent pas.")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
